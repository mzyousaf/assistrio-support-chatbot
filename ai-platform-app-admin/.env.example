# Copy to `.env.local` — NEXT_PUBLIC_* is inlined at build time.

# Nest API origin (no trailing slash). Used for:
# - Client apiFetch / credentialed calls to /api/admin/*
# - Middleware + serverAuth: GET /api/admin/me with forwarded cookies
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# If you run this Next app alongside assistrio-landing-site, use a different port, e.g.:
#   npx next dev -p 3002
# and open http://localhost:3002/admin

# Optional — src/app/chat-demo/page.tsx (widget demo bot id)
# NEXT_PUBLIC_CHAT_DEMO_BOT_ID=
