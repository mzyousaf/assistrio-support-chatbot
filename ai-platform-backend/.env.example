# Copy to `.env` in this directory.
#
# Boot-time validation: `src/config/config.schema.ts` (Joi). Missing or invalid required keys prevent startup.
# Other variables are read directly from `process.env` in `src/main.ts`, `src/lib/s3.ts`, `src/lib/ai-call.helper.ts`,
# `src/worker/jobs-cron.service.ts`, and `src/ingestion/ingestion.service.ts`.
# Widget API key env name: `src/lib/env-var-names.ts` (`CHAT_WIDGET_API_KEY`).

# ---------------------------------------------------------------------------
# Required at startup (Joi — must be present and valid)
# ---------------------------------------------------------------------------

# development | production | test
NODE_ENV=development

# HTTP listen port (Fastify binds 0.0.0.0)
PORT=8080

# MongoDB connection URI
MONGODB_URI=mongodb://127.0.0.1:27017/assistrio

# Signing secret for JWT sessions (minimum 16 characters)
JWT_SECRET=change-me-min-16-chars

# OpenAI API key (chat, embeddings, summaries). Key must exist; use a real value for requests to succeed.
OPENAI_API_KEY=

# Shared secret for ingestion job triggers: `POST /api/jobs/auto-run` header `x-job-runner-secret` (minimum 16 characters)
JOB_RUNNER_SECRET=change-me-min-16-chars

# ---------------------------------------------------------------------------
# HTTP / reverse proxy (`src/main.ts`)
# ---------------------------------------------------------------------------

# When `1`, `true`, or `yes`: trust `X-Forwarded-For` / `X-Real-IP` so rate limits use the real client IP (use behind nginx, ALB, Cloudflare, etc.).
# Leave unset when the app is exposed directly without a proxy (avoids client IP spoofing).
TRUST_PROXY=

# ---------------------------------------------------------------------------
# Customer Google OAuth (`src/auth/customer/*`)
# ---------------------------------------------------------------------------

# Optional at boot. All must be set for `GET /api/customer/auth/google` and the callback to work.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Registered in Google Cloud Console — must match exactly (e.g. `https://api.example.com/api/customer/auth/google/callback`).
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/api/customer/auth/google/callback

# Customer web app origin for post-login redirects (no trailing slash). Local dev often matches the Vite dev server port.
CUSTOMER_APP_BASE_URL=http://localhost:5174

# ---------------------------------------------------------------------------
# Server-to-server and internal endpoints (`src/config/config.factory.ts` + guards)
# ---------------------------------------------------------------------------

# `GET /api/public/landing/bots` — callers send header `X-API-Key`. If unset, the route responds 503 (not configured).
LANDING_SITE_BOTS_API_KEY=

# Widget runtime / testing routes — header `X-API-Key` or `Authorization: Bearer <key>`. If unset, guarded routes respond 503.
# When set, must be at least 16 characters (Joi). See `src/lib/env-var-names.ts`.
CHAT_WIDGET_API_KEY=

# Optional. Base URL for chat widget static assets (`assistrio-chat.js` / `.css`) used in server-generated embed snippets. Defaults to `https://widget.assistrio.com`.
CHAT_WIDGET_ASSET_ORIGIN=

# `POST /api/internal/admin-bootstrap/create-superadmin` — header `x-admin-bootstrap-token`. If unset, endpoint returns 503.
ADMIN_BOOTSTRAP_TOKEN=

# ---------------------------------------------------------------------------
# AWS S3 uploads (`src/lib/s3.ts`) — required when running code paths that upload or read via this client
# ---------------------------------------------------------------------------

# Region for the S3 client (required for `getClient()` / uploads).
AWS_REGION=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Bucket names for `uploadToS3`: public vs private visibility.
S3_PUBLIC_BUCKET=
S3_PRIVATE_BUCKET=

# When `1`, `true`, or `yes`, public uploads set ACL `public-read`. Leave unset if the bucket uses Block Public Access (default for many setups).
S3_PUBLIC_ACL=

# ---------------------------------------------------------------------------
# Workers and AI tuning (optional — defaults in code if unset)
# ---------------------------------------------------------------------------

# Max ingestion jobs processed per cron tick (default 5). `src/worker/jobs-cron.service.ts`
# JOBS_RUNNER_LIMIT=5

# Max summary jobs processed per cron tick (default 5). `src/worker/jobs-cron.service.ts`
# SUMMARY_JOBS_RUNNER_LIMIT=5

# OpenAI call timeouts in ms — `src/lib/ai-call.helper.ts` (defaults: embed 30000, completion 60000, summary 45000)
# CHAT_EMBED_TIMEOUT_MS=30000
# CHAT_COMPLETION_TIMEOUT_MS=60000
# CHAT_SUMMARY_TIMEOUT_MS=45000

# Minutes before a stuck ingestion job is reset (default 15). `src/ingestion/ingestion.service.ts`
# INGESTION_STUCK_TIMEOUT_MINUTES=15
