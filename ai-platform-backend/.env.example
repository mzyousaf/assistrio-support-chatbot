# Copy to `.env`. Placeholders only — never commit real `.env` or real secrets.
# Full reference: docs/environment.md
#
# === Production split (see docs/kb-worker-deployment.md and docs/environment.md) ===
# API: APP_MODE=api, ENABLE_KB_WORKER=false, TRUST_PROXY=1, KB_TRAINING_LOGS=false
# Runtime: APP_MODE=runtime, ENABLE_KB_WORKER=false (widget/chat only; no KB crons)
# Worker: APP_MODE=worker, ENABLE_KB_WORKER=true, TRUST_PROXY=1, KB_TRAINING_LOGS=false
# After extractionStatus migration: KNOWLEDGE_EXTRACTION_STATUS_BACKFILL=false
#
# -----------------------------------------------------------------------------
# App runtime
# -----------------------------------------------------------------------------
NODE_ENV=development
# When true, logs preview/playground AI tuning (temperature, max_tokens, prompt markers, token usage). Dev only.
DEBUG_CHAT_AI_SETTINGS=false
# When true, logs RAG answerability + evidence titles per chat turn (dev only).
DEBUG_RAG_DECISION=false
# When true, logs per-request chat latency breakdown (retrieval, completion, persistence timings only).
DEBUG_CHAT_LATENCY=false
# When true, logs Mongo chunk load metadata (no chunk text).
DEBUG_CHAT_RETRIEVAL_MONGO=false
# When true, logs retrieval result cache key hashes and hit/miss (no raw query text).
DEBUG_RETRIEVAL_CACHE=false
# Chat retrieval caps (defaults unchanged if unset).
# CHAT_RETRIEVAL_LIMIT=25
# CHAT_MAX_ITEMS_TO_SCORE=300
# CHAT_MAX_EVIDENCE_ITEMS=8
# CHAT_MAX_EVIDENCE_TOKENS=2200
# Development: all. Production API: api. Production worker: worker.
APP_MODE=all
PORT=8080
ALLOW_APP_MODE_ALL_IN_PRODUCTION=false
SKIP_DOTENV=
# Development: usually unset. Production behind reverse proxy: true or 1 (correct client IP for rate limits).
TRUST_PROXY=

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/assistrio_dev

# -----------------------------------------------------------------------------
# Public URLs / CORS (only names the backend reads)
# -----------------------------------------------------------------------------
# No PUBLIC_API_BASE_URL / LANDING_SITE_URL / ADMIN_APP_URL envs — see docs/environment.md.
CUSTOMER_APP_BASE_URL=http://localhost:3002
# Optional: shared customer session cookie domain (ar_customer_session only). Unset = host-only on API host.
# Production example when landing + app + API share a parent domain: SESSION_COOKIE_DOMAIN=.assistrio.com
# SESSION_COOKIE_DOMAIN=
CHAT_WIDGET_ASSET_ORIGIN=http://localhost:3001

# -----------------------------------------------------------------------------
# Auth / internal secrets
# -----------------------------------------------------------------------------
# Joi requires min 16 characters (use 32+ in production).
JWT_SECRET=replace-with-at-least-32-character-secret
JOB_RUNNER_SECRET=replace-with-at-least-32-character-secret
# Leave empty to disable bootstrap route (503).
ADMIN_BOOTSTRAP_TOKEN=
LANDING_SITE_BOTS_API_KEY=replace-with-landing-site-bots-api-key
CHAT_WIDGET_API_KEY=replace-with-chat-widget-api-key

# -----------------------------------------------------------------------------
# Google OAuth (names must match GOOGLE_OAUTH_*)
# -----------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/api/customer/auth/google/callback

# -----------------------------------------------------------------------------
# Storage / S3 (document upload + extraction read private objects)
# -----------------------------------------------------------------------------
AWS_REGION=replace-with-aws-region
AWS_ACCESS_KEY_ID=replace-with-aws-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-aws-secret-access-key
S3_PUBLIC_BUCKET=replace-with-public-assets-bucket
S3_PRIVATE_BUCKET=replace-with-private-documents-bucket
S3_PUBLIC_ACL=

# -----------------------------------------------------------------------------
# OpenAI / AI
# -----------------------------------------------------------------------------
OPENAI_API_KEY=replace-with-openai-api-key
CHAT_EMBED_TIMEOUT_MS=
CHAT_COMPLETION_TIMEOUT_MS=
CHAT_SUMMARY_TIMEOUT_MS=

# -----------------------------------------------------------------------------
# KB worker — APP_MODE + worker toggle (ENABLE_KB_WORKER appears only here)
# -----------------------------------------------------------------------------
# APP_MODE is set in "App runtime" above. Crons require all|worker + ENABLE_KB_WORKER=true.
ENABLE_KB_WORKER=true

# -----------------------------------------------------------------------------
# KB — logs & extractionStatus backfill
# -----------------------------------------------------------------------------
# true only while debugging; false in normal dev and production.
KB_TRAINING_LOGS=false
# Idempotent boot backfill for KnowledgeBaseItem.extractionStatus. Set false after production rows normalized.
KNOWLEDGE_EXTRACTION_STATUS_BACKFILL=true
# GET `/knowledge/training/status`: pipeline-active counts ignore KB rows with no Mongo touches newer than N minutes (default 30). Rows are not updated—presentation only.
# AGENT_TRAINING_PIPELINE_STALE_MINUTES=30

# -----------------------------------------------------------------------------
# KB — cron batch sizes (src/worker/jobs-cron.service.ts)
# -----------------------------------------------------------------------------
JOBS_RUNNER_LIMIT=10
SUMMARY_JOBS_RUNNER_LIMIT=5
KNOWLEDGE_TRAINING_JOBS_RUNNER_LIMIT=10
# After stuck-job recovery: reconcile document KB rows stuck pending/queued/processing when latest TrainJob is done and embeddings exist (see KnowledgeTrainKbDriftReconcileService). Default batch 25; set KNOWLEDGE_TRAIN_KB_DRIFT_RECONCILE_DISABLED=true to skip.
# KNOWLEDGE_TRAIN_KB_DRIFT_RECONCILE_BATCH=25
# KNOWLEDGE_TRAIN_KB_DRIFT_RECONCILE_DISABLED=false

# -----------------------------------------------------------------------------
# Table import (async CSV/XLSX → TableImportJob worker; src/ingestion/table-import.service.ts, jobs-cron)
# -----------------------------------------------------------------------------
# Max table import jobs claimed per cron tick. Default 3 if unset.
TABLE_IMPORT_JOBS_RUNNER_LIMIT=3
# Import session TTL in Mongo (createImportSession expiresAt). Default 24 hours.
TABLE_IMPORT_SESSION_TTL_HOURS=24
# After preview expires or is cancelled, wait this long (ms) before cron deletes the session row and re-deletes temp S3. Default 3600000 (1h); min 60000.
TABLE_IMPORT_SESSION_CLEANUP_GRACE_MS=3600000
# Max preview TableImportSession rows cleaned per KB worker cron tick. Default 50.
TABLE_IMPORT_SESSION_CLEANUP_BATCH=50
# Stuck recovery timeouts / retry caps for extract, train, table import live in:
#   src/knowledge/knowledge-pipeline-retry.constants.ts
# Max table import jobs per bot in queued+processing (confirm rejects beyond this). Default 3.
TABLE_IMPORT_MAX_LIVE_JOBS_PER_BOT=3
# Max TableImportJob documents created per bot per UTC day (0 = disable limit).
TABLE_IMPORT_MAX_STARTS_PER_BOT_PER_DAY=0
# Max bytes for Excel in-memory import path (preview + worker). Default 10 MiB.
# In-memory Excel import cap (preview + worker). Keep ≤ multipart/plan datasheet cap; CSV uses streaming + TABLE_IMPORT_CSV_MAX_SOURCE_BYTES.
TABLE_IMPORT_XLSX_MAX_BYTES=10485760
# Max first-sheet physical row span (!ref height) after XLSX.read; larger sheets must use CSV import.
# TABLE_IMPORT_BUFFER_PARSE_MAX_PHYSICAL_ROWS=25000
# Worker CSV stream byte cap (default: DEFAULT_KB_FIELD_LIMITS.datasheetMaxUploadBytes).
# TABLE_IMPORT_CSV_MAX_SOURCE_BYTES=20971520

# KB stuck timeouts + auto-retry caps (extract / train / table import): see
#   src/knowledge/knowledge-pipeline-retry.constants.ts

# -----------------------------------------------------------------------------
# KB — extract job claim / immediate processing (still env-configurable)
# -----------------------------------------------------------------------------
EXTRACT_JOB_IMMEDIATE_ON_UPLOAD=true
EXTRACT_JOB_CLAIM_LOOKAHEAD=50

# -----------------------------------------------------------------------------
# KB — stale document train loop guard & requeue spacing
# -----------------------------------------------------------------------------
DOCUMENT_TRAIN_STALE_LOOP_THRESHOLD=2
DOCUMENT_TRAIN_STALE_LOOP_WINDOW_MS=1200000
INGEST_SKIP_REQUEUE_DELAY_MS=30000

# -----------------------------------------------------------------------------
# KB — ingest reconciler & bad upload/source sweep
# -----------------------------------------------------------------------------
KNOWLEDGE_INGEST_RECONCILER_LIMIT=20
KNOWLEDGE_INGEST_RECONCILER_DISABLED=false
EXTRACT_INGEST_RECONCILER_DISABLED=false
EXTRACT_INGEST_RECONCILER_LIMIT=
KNOWLEDGE_UPLOAD_BAD_SOURCE_SWEEP_LIMIT=25
KNOWLEDGE_UPLOAD_BAD_SOURCE_SWEEP_DISABLED=false

# -----------------------------------------------------------------------------
# KB — worker / cron structured logs (debug)
# -----------------------------------------------------------------------------
# Global default when a per-cron flag is unset. Only the string "true" enables logging.
KB_CRON_LOGS=false
# Optional per-cron overrides: "true" | "false" | unset (use KB_CRON_LOGS).
# KB_CRON_LOG_CONTENT_EXTRACTION=
# KB_CRON_LOG_KNOWLEDGE_TRAINING=
# KB_CRON_LOG_TABLE_IMPORT=
# KB_CRON_LOG_SUMMARY_JOBS=
# KB_CRON_LOG_KNOWLEDGE_PURGE=
# KB_CRON_LOG_BOT_PURGE=
# KB_CRON_LOG_BACKFILL=
# KB_CRON_LOG_APP_BOOT=

# -----------------------------------------------------------------------------
# KB — soft-delete grace hard purge (worker cron)
# -----------------------------------------------------------------------------
# Rows are soft-deleted immediately on user remove; hard purge runs periodically.
KNOWLEDGE_ITEM_PURGE_AFTER_MINUTES=30
KNOWLEDGE_ITEM_PURGE_BATCH_LIMIT=100
# Cron interval is 30 minutes in code (@Cron on JobsCronService); change there if needed.
KNOWLEDGE_ITEM_PURGE_INTERVAL_MINUTES=30

# Soft-deleted bots are hard-purged after this grace (worker @Cron on JobsCronService).
BOT_PURGE_AFTER_MINUTES=1440
BOT_PURGE_BATCH_LIMIT=25
