# Copy to .env — validated by src/config/config.schema.ts (required keys must be set for boot).

# --- Core (required by validation) ---
NODE_ENV=development
PORT=3001
MONGODB_URI=mongodb://127.0.0.1:27017/assistrio
JWT_SECRET=change-me-min-16-chars
OPENAI_API_KEY=
JOB_RUNNER_SECRET=change-me-min-16-chars

# --- Server (src/main.ts) ---
# 1/true/yes when behind a reverse proxy (real client IP for rate limits)
TRUST_PROXY=

# --- Customer Google OAuth (src/auth/customer/*) ---
# All required when using GET /api/customer/auth/google. Leave empty if you do not use customer Google login locally.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must match Google Cloud Console exactly — API origin + path (not the Vite app port).
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/api/customer/auth/google/callback
# Post-login redirects (no trailing slash). Must match assistrio-customer-app dev origin (see vite.config server.port).
CUSTOMER_APP_BASE_URL=http://localhost:5174
# Marketing / landing site origin (optional; allowlists / future redirects). Default local Next is :3000.
LANDING_SITE_BASE_URL=http://localhost:3000

# --- Optional app config (src/config/config.factory.ts) ---
AWS_REGION=
S3_BUCKET=
CLOUDFRONT_BASE_URL=
# GET /api/public/landing/bots — server sends header X-API-Key (must match caller)
LANDING_SITE_BOTS_API_KEY=
# GET /api/widget/testing/bot — X-API-Key (src/lib/env-var-names.ts)
CHAT_WIDGET_API_KEY=

# POST /api/internal/admin-bootstrap/create-superadmin — header x-admin-bootstrap-token (omit to disable route)
ADMIN_BOOTSTRAP_TOKEN=

# --- AWS credentials for uploads (src/lib/s3.ts) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_PUBLIC_BUCKET=
S3_PRIVATE_BUCKET=
# Set true only if bucket allows ACL public-read
S3_PUBLIC_ACL=

# --- Optional tuning ---
# JOBS_RUNNER_LIMIT=5
# SUMMARY_JOBS_RUNNER_LIMIT=5
# CHAT_EMBED_TIMEOUT_MS=
# CHAT_COMPLETION_TIMEOUT_MS=
# CHAT_SUMMARY_TIMEOUT_MS=
# INGESTION_STUCK_TIMEOUT_MINUTES=15
