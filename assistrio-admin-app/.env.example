# Copy to .env — Vite exposes only vars prefixed with VITE_.

# Nest API origin (no trailing slash). Browser sends `ar_admin_session` via credentials: include.
VITE_API_BASE_URL=http://localhost:3001

# Customer app origin for deploy share/iframe URLs (no trailing slash). Optional in local dev.
# VITE_CUSTOMER_APP_ORIGIN=http://localhost:5173

# Dev server port is set in vite.config.ts (default 3003).
