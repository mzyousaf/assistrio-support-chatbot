# Copy to .env — Vite exposes only vars prefixed with VITE_.

# Nest API origin (no trailing slash). Browser sends session cookies here (credentials: include).
# Must match the Assistrio backend (default local PORT=3001).
# Used for customer REST APIs and for the in-app widget preview (`/api/widget/preview/init` + `/chat`).
VITE_API_BASE_URL=http://localhost:3001

# When true (and `npm run dev`), logs previewOverrides.config on each playground preview chat send.
VITE_DEBUG_CHAT_AI_SETTINGS=false

# Dev server port is set in vite.config.ts (default 5174). Backend CUSTOMER_APP_BASE_URL should match
# http://localhost:<that-port> for Google OAuth return redirects.

# Optional: origin where assistrio-chat.css / assistrio-chat.js are served (defaults to production CDN in snippets).
# VITE_WIDGET_ASSET_ORIGIN=https://widget.assistrio.com
